# URL pública da API. Usada somente no servidor da vitrine.
CATALOG_API_URL=https://leyde-braga-admin.vercel.app/api/v1
# Para API local em outra porta: http://localhost:3001/api/v1
# Não adicionar credenciais PostgreSQL ou segredos administrativos à vitrine.

# Opcional e público. Vazio = nenhum Analytics é carregado.
# Ative somente após configurar a propriedade, revisar a política e o consentimento.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ID público do Pixel da loja. Não é token de acesso nem senha.
# O código usa este ID por padrão; definir vazio desativa o Pixel.
# Carregado somente após consentimento de publicidade.
NEXT_PUBLIC_META_PIXEL_ID=1784326125895756
